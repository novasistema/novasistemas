{
  "entities": {
    "products": {
      "title": "Products & Systems",
      "description": "Products, systems, and portfolio applications offered by Nova AJ",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "sku": { "type": "string" },
        "description": { "type": "string" },
        "demoUrl": { "type": "string" },
        "inPortfolio": { "type": "boolean" },
        "hasSubscription": { "type": "boolean" },
        "subscriptionPrice": { "type": "number" },
        "subscriptionPeriod": { "type": "string" },
        "adminLoginUrl": { "type": "string" },
        "adminUser": { "type": "string" },
        "adminPassword": { "type": "string" },
        "creatorUser": { "type": "string" },
        "creatorPassword": { "type": "string" },
        "accessNotes": { "type": "string" },
        "extraCredentials": { "type": "array" }
      },
      "required": ["name", "price", "sku"]
    },
    "clients": {
      "title": "Clients",
      "description": "Client directory for Nova AJ",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "taxId": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["name"]
    },
    "sales": {
      "title": "Sales Records",
      "description": "Sales and transactions history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["clientId", "totalAmount"]
    },
    "subscriptions": {
      "title": "Subscriptions",
      "description": "Recurring client subscriptions and memberships",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "systemName": { "type": "string" },
        "amount": { "type": "number" },
        "period": { "type": "string" },
        "startDate": { "type": "string" },
        "nextBillingDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["clientId", "amount"]
    },
    "banners": {
      "title": "Announcements",
      "description": "Announcements and updates shown on landing and admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "description"]
    }
  }
}
